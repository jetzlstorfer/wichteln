{
  "name": "wichteln",
  "version": "1.0.0",
  "private": true,
  "description": "Wichteln mit dem Christkind – eine familienfreundliche Wichtel-App",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server/index.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:tables": "node scripts/test-tables.mjs",
    "verify": "npm run typecheck && npm test && npm run build && node scripts/test-tables.mjs --smoke",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "assets": "node scripts/process-assets.mjs",
    "maintenance": "tsx server/src/index.ts --maintenance",
    "import:sqlite": "tsx server/src/import-sqlite.ts",
    "dev:storage": "azurite-table --tableHost 127.0.0.1 --location data/azurite --silent --disableTelemetry"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.0",
    "@azure/identity": "^4.13.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "azurite": "^3.35.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
